# Copy this file to ".env" and fill in real values before starting the server.

# Any long random string - used to sign login session cookies.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-this-to-a-long-random-string

# Port the server listens on. Render / most hosts set this automatically -
# you usually don't need to change it.
PORT=3000

# A secret key you choose, used to protect the /api/admin/export data-export
# endpoint. Keep this private - anyone with it can download all stored data.
ADMIN_KEY=change-this-to-a-different-long-random-string
